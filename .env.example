# .env.example — copy to .env and fill in your values.
# NEVER commit the real .env (it holds your team token).

# Team token for the scoreboard (X-Team-Token header). REQUIRED.
ATTDEF_TEAM_TOKEN=PASTE_YOUR_TEAM_TOKEN_HERE

# Scoreboard submission endpoint.
ATTDEF_SUBMIT_URL=http://103.145.226.89:8080/flags

# Seconds between round START times. Competition tick = 180.
ATTDEF_TICK=180

# 0 = run forever. Set > 0 only for testing (stop after N rounds).
ATTDEF_MAX_ROUNDS=0

# Per-exploit timeout (seconds) when a challenge has no timeout.
ATTDEF_EXPLOIT_TIMEOUT=30

# Health-check timeout (seconds).
ATTDEF_HEALTH_TIMEOUT=3
