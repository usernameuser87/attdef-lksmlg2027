# .env.example — copy to .env and fill in your values.
# NEVER commit the real .env (it holds your credentials).

# =====================================================================
# PLAYIT PLUS 2026 mode (ADTickPlatform participant API v2.0.0)
# Setting PLAYIT_EMAIL + PLAYIT_PASSWORD switches the framework to
# platform mode: targets from GET /api/v2/services, tick from
# GET /api/v2/game/status, submit via POST /api/v2/submit (JWT).
# =====================================================================

# Platform base URL (organizers may give a different host).
PLAYIT_BASE_URL=https://10.0.2.3

# Your participant account. REQUIRED for platform mode.
PLAYIT_EMAIL=
PLAYIT_PASSWORD=

# 1 = verify the platform's TLS certificate. Default off (CTF
# platforms usually use self-signed certificates).
PLAYIT_VERIFY_TLS=0

# =====================================================================
# Legacy LKSMLG 2027 scoreboard mode (used when PLAYIT_* are unset)
# =====================================================================

# Team token for the scoreboard (X-Team-Token header).
ATTDEF_TEAM_TOKEN=PASTE_YOUR_TEAM_TOKEN_HERE

# Scoreboard submission endpoint.
ATTDEF_SUBMIT_URL=http://103.145.226.89:8080/flags

# Seconds between round START times (legacy mode / platform fallback).
ATTDEF_TICK=180

# 0 = run forever. Set > 0 only for testing (stop after N rounds).
ATTDEF_MAX_ROUNDS=0

# Per-exploit timeout (seconds) when a challenge has no timeout.
ATTDEF_EXPLOIT_TIMEOUT=30

# Health-check timeout (seconds).
ATTDEF_HEALTH_TIMEOUT=3
